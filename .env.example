DEEPSEEK_API_KEY=
BASE_URL=https://api.deepseek.com
MODEL_NAME=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=1.5
LLM_TEMPERATURE=
LLM_MAX_TOKENS=

# Logging.
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s %(levelname)s [%(name)s] %(message)s

# DashScope Embedding for ChromaDB vector search.
DASHSCOPE_API_KEY=

# Neo4j knowledge graph.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Local ChromaDB path. Leave empty to use ./chromadb.
CHROMA_PATH=

# Session storage. Use "redis" in production and "memory" for local fallback.
SESSION_STORE=memory
SESSION_TTL_SECONDS=7200
SESSION_STORE_FALLBACK_TO_MEMORY=true
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=medical-chat:session

# Persistent chat history storage.
HISTORY_DB_URL=mysql+pymysql://root:password@127.0.0.1:3306/medical_chat?charset=utf8mb4

# Answer cache. Completed answers can be reused during the TTL window.
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_MIN_QUERY_LENGTH=12

# MinerU：PDF 转 Markdown 的云端令牌，仅数据构建脚本使用。
MINERU_TOKEN=
